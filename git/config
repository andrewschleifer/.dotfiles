[user]
	name = Andrew Schleifer
	email = me@andrewschleifer.name
[alias]
	amend = commit --amend
	b = branch
	bl = blame -w -M
	cherrypick = cherry-pick
	ci = commit
	co = checkout
	commi = commit
	connit = commit
	cp = cherry-pick
	detach = checkout HEAD^0
	df = diff
	dfs = diff --staged
	dt = difftool
	grp = grep
	grpe = grep
	l = log --graph --branches --date-order --pretty=format:'%C(yellow)%h%C(reset) %s%C(auto)%(decorate:separator= ,tag=)' --decorate-refs="HEAD"
	ll = l --decorate-refs="HEAD" --decorate-refs="refs/heads/*" --decorate-refs="refs/tags/*"
	lr = l --decorate-refs="HEAD" --decorate-refs="refs/heads/*" --decorate-refs="refs/tags/*" --decorate-refs="refs/remotes/*"
	lu = log --patch --cc
	mt = mergetool
	pl = pull --ff-only
	st = status --short --branch
	stashpop = stash pop
	t = tag -n1
	tl = l
	tlu = lu
	tpull = pull
	tpush = push
	w = whatchanged
	unstage = reset HEAD
[branch]
	autosetupmerge = true
[color]
	ui = true
[color "decorate"]
	branch = white
	remoteBranch = dim white
	tag = green
	HEAD = ul white
[color "diff"]
	commit = "brightyellow"
[commit]
	verbose = 2
[core]
	quotepath = false
	editor = /usr/bin/vim
	abbrev = 12
[diff]
	algorithm = histogram
	renames = copies
	mnemonicprefix = true
	submodule = log
	tool = Kaleidoscope
[difftool]
	prompt = false
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[log]
	date = iso
	mailmap = true
[merge]
	keepBackup = false
	tool = Kaleidoscope
[mergetool]
	prompt = false
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[push]
	default = current
[rebase]
	autosquash = true
[status]
	showUntrackedFiles = all
