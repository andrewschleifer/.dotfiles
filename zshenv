. ${HOME}/.dotfiles/environment.sh

export PATH="${HOME}/.bin:/usr/local/sbin:/usr/local/bin:/opt/pkg/bin:/opt/pkg/sbin:/opt/local/bin:/opt/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

export CLASSPATH="${HOME}/Library/Java"
export COPYFILE_DISABLE=true
export COPY_EXTENDED_ATTRIBUTES_DISABLE=true
export GNUPGHOME="${HOME}/.config/gnupg"
export GOPATH="${HOME}/Library/Go"
export NPM_CONFIG_PREFIX="${HOME}/Library/Node/packages"
export RBENV_ROOT="${HOME}/Library/Ruby/versions"
export SHELL_SESSIONS_DISABLE=1
